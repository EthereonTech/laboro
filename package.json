{
  "name": "laboro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs --all",
    "dev:deps": "node scripts/dev.mjs --deps-only",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/api",
    "lint": "npm run lint --workspace=apps/api"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "react-dom": "19.0.0"
  },
  "overrides": {
    "@types/react": "19.0.14",
    "@types/react-dom": "19.0.6"
  }
}
